# Koneksi database MySQL (pakai DB yang sama dengan versi Laravel: ga_stock)
DATABASE_URL="mysql://root@127.0.0.1:3306/ga_stock"

# Secret penandatangan session cookie (JWT). Buat acak, mis:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
