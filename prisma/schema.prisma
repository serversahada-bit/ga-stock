// Skema ini dipetakan PERSIS ke tabel database Laravel (ga_stock) yang sudah ada.
// Tidak membuat/alter tabel — hanya dibaca/ditulis oleh Prisma Client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  INBOUND
  OUTBOUND
}

model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name            String    @db.VarChar(150)
  email           String    @unique @db.VarChar(191)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  password        String    @db.VarChar(255)
  role            String    @default("view") @db.VarChar(20)
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  @@map("users")
}

model Category {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @unique @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  products Product[]

  @@map("categories")
}

model Division {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @unique @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  movements StockMovement[]

  @@map("divisions")
}

model Product {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  categoriesId BigInt    @map("categories_id") @db.UnsignedBigInt
  sku          String    @unique @db.VarChar(50)
  name         String    @db.VarChar(150)
  unit         String    @default("pcs") @db.VarChar(20)
  stock        Int       @default(0) @db.UnsignedInt
  minStock     Int       @default(0) @map("min_stock") @db.UnsignedInt
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  category  Category        @relation(fields: [categoriesId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([categoriesId])
  @@index([name])
  @@map("products")
}

model StockMovement {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  productId  BigInt       @map("product_id") @db.UnsignedBigInt
  divisionId BigInt?      @map("division_id") @db.UnsignedBigInt
  type       MovementType
  qty        Int          @db.UnsignedInt
  note       String?      @db.VarChar(255)
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamp(0)
  userId     BigInt?      @map("user_id") @db.UnsignedBigInt
  createdAt  DateTime?    @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime?    @map("updated_at") @db.Timestamp(0)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id])

  @@index([productId])
  @@index([divisionId])
  @@index([type, occurredAt])
  @@map("stock_movements")
}
